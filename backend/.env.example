# Copy to backend/.env and fill in. Never commit the real .env.

PORT=8000

# --- AI (https://console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile
# AI messages each IP gets by default (admins can change this per IP)
AI_DEFAULT_LIMIT=5

# --- Database (optional; limits fall back to in-memory without it) ---
MONGODB_URI=

# --- Admin dashboard (#dashboard) ---
# Disabled unless set. At least 12 characters; common defaults are rejected.
ADMIN_PASSWORD=
# Secret for signing admin session tokens (generate one with: openssl rand -hex 32)
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=8

# --- Network ---
# Allowed browser origins, comma-separated (localhost is allowed in development)
CORS_ORIGINS=https://your-frontend.vercel.app
# Number of reverse proxies in front of the API (Render/Railway/Nginx = 1, none = 0)
TRUST_PROXY=1

# --- Sandbox ---
# auto | hardened | none   (hardened is set automatically in the Docker image)
SANDBOX_MODE=auto
SANDBOX_RUN_TIMEOUT_MS=5000
SANDBOX_COMPILE_TIMEOUT_MS=15000
SANDBOX_MEMORY_MB=256
SANDBOX_MAX_CONCURRENCY=4
# Only for trusted, private deployments without Docker:
# ALLOW_UNSAFE_EXECUTION=true
